{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Android",
  "identifier": "ai.opencode.android.dev",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCode"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../desktop/src-tauri/icons/dev/128x128.png"]
  }
}
